<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Panorama Processing Complete</title>
</head>
<body>
    <p>Hello,</p>
    <p>Your panorama <strong>{{ name }}</strong> has been processed successfully and is ready for review.</p>
    <p>Processing time: {{ processing_time_hours }} hours</p>
    <p>Storage size: {{ file_size_gb }} GB</p>
    <p><a href="{{ website_url }}/admin/panoramas/{{ panorama_id }}">{{ website_url }}/admin/panoramas/{{ panorama_id }}</a></p>
    <p>Best regards,<br>Tree Map Team</p>
</body>
</html>
