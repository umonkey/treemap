# TreeMap local development configuration.
#
# This configuration is intended for isolated development on a local machine.
# It does not require working AWS SQS or S3 credentials.

# HTTP server.
server_port = 8000
workers = 2

# Use a persistent local SQLite database.
database = "sqlite"
sqlite_path = "var/database.sqlite"

# Background queue.
#
# When sqs_url is not configured, the backend uses DatabaseQueue.
# This stores background jobs in the SQLite database.

# Use the local filesystem instead of S3.
file_storage = "local"
file_folder = "var/files"

# Local storage bucket names.
# Some backend services require these names during initialization.
files_bucket = "files"
backup_bucket = "backups"
panoramas_sources_bucket = "panoramas-sources"
panoramas_bucket = "panoramas"

# Local application URLs.
files_base_url = "http://localhost:8000/v1/files/"
website_url = "http://localhost:5173"

# Read development-only secrets from Docker Compose.
secrets_path = "/run/secrets"

# OpenStreetMap synchronization.
#
# Scheduled OSM synchronization is disabled through the local
# Supervisor configuration.
#
# No bot_user_id or OSM API credentials are configured.