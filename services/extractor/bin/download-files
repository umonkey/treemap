#!/bin/sh
# Download source video and track from the S3 file storage.
# Skip if the files already exist (which is a debug only feature).

if [ -f var/video.mp4 ]; then
    echo "Found cached var/video.mp4, not downloading."
elif [ -z "$VIDEO_SOURCE" ]; then
    echo "VIDEO_SOURCE not set, cannot download the file."
    exit 1
else
    aws s3 --endpoint-url="$AWS_ENDPOINT_URL" cp --no-progress "$VIDEO_SOURCE" var/video.mp4
fi

if [ -f var/track.gpx ]; then
    echo "Found cached var/track.gpx, not downloading."
elif [ -z "$GPX_SOURCE" ]; then
    echo "GPX_SOURCE not set, cannot download the file."
    exit 1
else
    aws s3 --endpoint-url="$AWS_ENDPOINT_URL" cp --no-progress "$GPX_SOURCE" var/track.gpx
fi
