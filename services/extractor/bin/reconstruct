#!/bin/bash

set -e
set -o pipefail

if [ -z "$DATASET" ]; then
    echo "DATASET variable not set, cannot continue."
    exit 1
fi

# The name of the flag file to skip the process in case of a rerun.
LOCK=reconstructed.txt

if [ -f "$DATASET/flags/$LOCK" ]; then
    echo "Found existing reconstruction, reusing."
    echo "Resrart with: rm -rf $DATASET/flags/$LOCK $DATASET/reconstruction.json"
    exit 0
fi

# Regenerate the dataset config with a single process.  OpenSfM preloads common
# tracks for every image pair when processes > 1, which is the dominant memory
# allocation during incremental reconstruction; processes is also forwarded to
# Ceres as its thread count, so 1 makes it single-threaded.  Feature detection
# and matching still use all cores.
PROCESSES=1 bin/write-config

mkdir -p $DATASET/features $DATASET/logs

echo "=== Reconstructing the SfM scene ==="
time opensfm reconstruct $DATASET 2>&1 | tee $DATASET/logs/reconstruct.log
sync

# Upload the results so that if next step crashes, we don't have to re-run this.
time bin/upload-dataset $DATASET $LOCK
