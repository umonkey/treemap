#!/bin/bash
# This script orchestrates the whole process.

set -e
exec 1>&2

DATASET=var/dataset

mkdir -p $DATASET/images var/output

# OpenSfM expects the config in the dataset folder, put it there.
# We have it in the root initially because the dataset folder might be mounted.
cp config.yaml $DATASET/

# (1) Download the files.
# This downloads source files video.mp4 and track.gpx from S3 and puts them in var/
echo "=== Downloading dataset files ==="
time bin/download-dataset

# (2) Extract frames.
# This extracts a single frame every 3 meters, from the original video.
if [ ! -f $DATASET/frames_extracted.txt ]; then
    echo "=== Extracting frames ==="
    time bin/app extract --distance 3 --offset "${GPX_OFFSET:-0.0}" var/dataset/video.mp4 var/dataset/track.gpx var/dataset/images
    echo yes > $DATASET/frames_extracted.txt
    time bin/upload-dataset
else
    echo "Found previously extracted frames."
fi

# Double check config existence, otherwise we run with default settings
# which make the process multiple times slower.
if [ ! -f var/dataset/config.yaml ]; then
    echo "OpenSfM config not found, abort."
    exit 1
fi

# This creates a mask for each extracted frame.
# The mask contains upper white part and black bottom part.  The black part is ignored
# by OpenSfM.  We use this to mask the car or the human operator, because having a static
# part of the image (like a car) might confuse the algorithm.
#
# This script creates a png file for each jpg frame, e.g. images/frame_001.jpg => masks/frame_001.jpg.png
if [ ! -f $DATASET/masks_created.txt ]; then
    echo "=== Creating masks ==="
    bin/app create-masks $DATASET
    echo yes > $DATASET/masks_created.txt
    time bin/upload-dataset
else
    echo "Found previously created masks."
fi

# (3) Set up cameras for OpenSfM
if [ ! -f $DATASET/camera_overrides_created.txt ]; then
    echo "=== Creating camera overrides ==="
    bin/app create-camera-overrides $DATASET/video.mp4 > $DATASET/camera_models_overrides.json
    echo yes > $DATASET/camera_overrides_created.txt
else
    echo "Found previously created camera overrides."
fi

# (4) Extract image metadata to var/dataset/exif/*.jpg.exif
# Creates a bunch of JSON files with the image metadata extracted, one per input frame.
if [ ! -f $DATASET/metadata_extracted.txt ]; then
    echo "=== OpenSfM: extract_metadata ==="
    time opensfm extract_metadata var/dataset
    echo yes > $DATASET/metadata_extracted.txt
    time bin/upload-dataset
else
    echo "Found previously extracted metadata."
fi

# (5) Apply Turn-Aware GPS Smoothing and metadata injection
# Smoothen the coordinates to avoid consumer grade signal fluctuation,
# using a turn-aware algorithm to avoid smoothing sharp turns.
if [ ! -f $DATASET/smoothed_coordinates.txt ]; then
    echo "=== Smoothing the GPS coordinates ==="
    time bin/smooth-gps var/dataset/exif
    echo yes > $DATASET/smoothed_coordinates.txt
    time bin/upload-dataset
else
    echo "Found previously smoothed coordinates."
fi

# (6) Run the core SfM pipeline
if [ ! -f $DATASET/features_detected.txt ]; then
    echo "=== OpenSfM: detect_features ==="
    time opensfm detect_features var/dataset
    echo yes > $DATASET/features_detected.txt
    time bin/upload-dataset
else
    echo "Found previously detected features."
fi

if [ ! -f $DATASET/features_matched.txt ]; then
    echo "=== OpenSfM: match_features ==="
    time opensfm match_features var/dataset
    echo yes > $DATASET/features_matched.txt
    time bin/upload-dataset
else
    echo "Found previously matched features."
fi

if [ ! -f $DATASET/tracks_created.txt ]; then
    echo "=== OpenSfM: create_tracks ==="
    time opensfm create_tracks var/dataset
    echo yes > $DATASET/tracks_created.txt
    time bin/upload-dataset
else
    echo "Found previously created tracks."
fi

if [ ! -f $DATASET/reconstructed.txt ]; then
    echo "=== OpenSfM: reconstruct ==="
    time opensfm reconstruct var/dataset
    echo yes > $DATASET/reconstructed.txt
    time bin/upload-dataset
else
    echo "Found previously reconstructed scene."
fi

# (7) Prune outlierpoints (500m+)
if [ ! -f $DATASET/points_pruned.txt ]; then
    echo "=== Pruning remote points ==="
    bin/prune-points var/dataset
    echo yes > $DATASET/points_pruned.txt
    time bin/upload-dataset
else
    echo "Found previously pruned points."
fi

if [ ! -f $DATASET/ply_exported.txt ]; then
    echo "=== OpenSfM: export_ply ==="
    time opensfm export_ply var/dataset
    echo yes > $DATASET/ply_exported.txt
    time bin/upload-dataset
else
    echo "Found previously exported ply."
fi

# (8) Verify result quality
echo "=== Verifying errors ==="
bin/verify-error var/dataset

# (9) Final output generation
echo "=== Writing output ==="
bin/write-output var/dataset var/output

# (10) Upload the results.
echo "=== Uploading results ==="
bin/upload-results
