#!/bin/bash
# This script orchestrates the whole process.

set -e
exec 1>&2

DATASET=var/dataset

mkdir -p $DATASET/images var/output

# OpenSfM expects the config in the dataset folder, put it there.
# We have it in the root initially because the dataset folder might be mounted.
cp config.yaml $DATASET/

bin/download-dataset
bin/extract-frames
bin/create-masks
bin/create-camera-overrides
bin/extract-metadata
bin/detect-features
bin/match-features
bin/create-tracks
bin/reconstruct

# Final output generation
echo "=== Writing output ==="
bin/write-output $DATASET var/output

# Upload the results.
echo "=== Uploading results ==="
time bin/upload-results
