#!/bin/sh
# This script orchestrates the whole process.

set -e

mkdir -p var/dataset/images

# (1) Download the files.
bin/download-files

# (2) Extract frames.
bin/app extract --distance 3 --offset "${GPX_OFFSET:-0.0}" var/video.mp4 var/track.gpx var/dataset/images

# (3) Set up cameras for OpenSfM
bin/app create-camera-overrides var/video.mp4 > var/dataset/camera_models_overrides.json

# (4) Extract image metadata to var/dataset/exif/*.jpg.exif
opensfm extract_metadata var/dataset

# (5) Apply Turn-Aware GPS Smoothing and metadata injection
bin/smooth-gps
