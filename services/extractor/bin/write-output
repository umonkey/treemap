#!/usr/bin/env python3
# This file reads `trajectory.geojson`,
# filters shots by minimum distance (MIN_DISTANCE environment variable, default 5.0m),
# finds matching source images, geo-tags them and puts them in the `var/dataset/output` folder,
# then creates a file `images.json` with information on all images.

import os
import sys

try:
    import numpy as np  # noqa: F401
except ImportError:
    venv_py = os.path.abspath(
        os.path.join(os.path.dirname(__file__), "..", ".venv", "bin", "python3")
    )
    if os.path.exists(venv_py) and sys.executable != venv_py:
        os.execv(venv_py, [venv_py] + sys.argv)
    raise

import csv
import glob
import json
import math
import shutil
import subprocess


def haversine_distance(lat1, lon1, lat2, lon2):
    """Calculate the great-circle distance between two points

    on the Earth (specified in decimal degrees). Returns distance in meters.
    """
    R = 6371000.0  # Earth radius in meters
    phi1 = math.radians(lat1)
    phi2 = math.radians(lat2)
    dphi = math.radians(lat2 - lat1)
    dlambda = math.radians(lon2 - lon1)

    a = (
        math.sin(dphi / 2.0) ** 2
        + math.cos(phi1) * math.cos(phi2) * math.sin(dlambda / 2.0) ** 2
    )
    c = 2.0 * math.atan2(math.sqrt(a), math.sqrt(1.0 - a))
    return R * c


def main(dataset_dir, output_dir):
    os.makedirs(output_dir, exist_ok=True)
    # 1. Clean output directory
    print("Cleaning output directory...")
    for f in glob.glob(os.path.join(output_dir, "*.jpg")):
        os.remove(f)

    min_distance = float(os.environ.get("MIN_DISTANCE", "5.0"))
    print(f"Minimum distance filter between output images: {min_distance} meters")

    trajectory_path = os.path.join(dataset_dir, "trajectory.geojson")

    processed_shots = set()
    csv_data = []
    images_data = []

    if not os.path.exists(trajectory_path):
        print(f"Error: aligned trajectory not found at {trajectory_path}.")
        print("Please run bin/align-trajectory first.")
        sys.exit(1)

    print(f"Reading aligned trajectory from {trajectory_path}...")
    with open(trajectory_path, "r") as f:
        geojson_data = json.load(f)

    # Collect and sort point features by frame index
    point_features = []
    for feat in geojson_data.get("features", []):
        if feat.get("geometry", {}).get("type") != "Point":
            continue
        props = feat.get("properties", {})
        coords = feat.get("geometry", {}).get("coordinates", [])
        shot_id = props.get("shot_id")
        if not shot_id or shot_id in processed_shots or len(coords) < 3:
            continue
        point_features.append((props.get("index", 0), shot_id, coords, props))

    point_features.sort(key=lambda x: x[0])

    last_lat, last_lon = None, None
    written_count = 0
    skipped_count = 0

    for idx, shot_id, coords, props in point_features:
        processed_shots.add(shot_id)
        lon, lat, alt = coords[0], coords[1], coords[2]

        # Check distance from last written shot
        if min_distance > 0 and last_lat is not None and last_lon is not None:
            dist = haversine_distance(last_lat, last_lon, lat, lon)
            if dist < min_distance:
                skipped_count += 1
                continue

        # Accept this shot
        last_lat, last_lon = lat, lon
        written_count += 1

        src_path = os.path.join(dataset_dir, "images", shot_id)
        dst_path = os.path.join(output_dir, shot_id)

        if not os.path.exists(src_path):
            print(f"Warning: source image {src_path} not found, skipping.")
            continue

        shutil.copy2(src_path, dst_path)

        heading = props.get("heading", 0.0)
        pitch = props.get("pitch", 0.0)
        roll = props.get("roll", 0.0)

        csv_data.append(
            {
                "SourceFile": os.path.abspath(dst_path),
                "GPSLatitude": lat,
                "GPSLongitude": lon,
                "GPSAltitude": alt,
                "GPSLatitudeRef": "N" if lat >= 0 else "S",
                "GPSLongitudeRef": "E" if lon >= 0 else "W",
                "GPSAltitudeRef": 0,
                "XMP-GPano:PoseHeadingDegrees": heading,
                "XMP-GPano:PosePitchDegrees": pitch,
                "XMP-GPano:PoseRollDegrees": roll,
                "XMP-GPano:ProjectionType": "equirectangular",
                "XMP-GPano:FullPanoWidthPixels": 7680,
                "XMP-GPano:FullPanoHeightPixels": 3840,
                "XMP-GPano:UsePanoramaViewer": "True",
            }
        )

        images_data.append(
            {
                "filename": shot_id,
                "latitude": float(lat),
                "longitude": float(lon),
                "altitude": float(alt),
                "heading": float(heading),
                "pitch": float(pitch),
                "roll": float(roll),
            }
        )

    print(
        f"Distance filtering complete: kept {written_count} shots, skipped {skipped_count} shots (MIN_DISTANCE={min_distance}m)."
    )

    if not csv_data:
        print("Error: No valid image shots found in trajectory.geojson.")
        sys.exit(1)

    # 4. Write images.json
    images_json_path = os.path.join(output_dir, "images.json")
    images_data.sort(key=lambda x: x["filename"])
    with open(images_json_path, "w") as f:
        json.dump(images_data, f, indent=4)

    # 5. Write CSV for exiftool
    csv_path = os.path.join(output_dir, "metadata.csv")
    with open(csv_path, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=csv_data[0].keys())
        writer.writeheader()
        writer.writerows(csv_data)

    # 6. Run exiftool
    print(f"Applying metadata to {len(csv_data)} images using exiftool...")
    subprocess.run(
        [
            "exiftool",
            "-csv=" + csv_path,
            "-overwrite_original",
            "-n",  # Use numeric values for coordinates
            output_dir,
        ]
    )

    # Clean up temp CSV
    os.remove(csv_path)
    print("Done!")


if __name__ == "__main__":
    main(*sys.argv[1:])
