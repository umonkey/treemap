#!/bin/sh
# Download source video and track from the S3 file storage.
# Skip if the files already exist (which is a debug only feature).

if [ -n "$DATASET_URL" ]; then
    echo "Downloading dataset files from $DATASET_URL ..."
    aws s3 --endpoint-url="$AWS_ENDPOINT_URL" sync --no-progress --size-only --delete "$DATASET_URL" var/dataset/
fi
