#!/bin/bash
# Upload dataset artifacts (frames, track and flags) to the S3 file storage.
# The source video is never uploaded; it is streamed during extraction and must
# not be copied into the dataset bucket even when a local debug copy exists.

if [ -z "$2" ]; then
    echo "Usage: $0 dataset_path lock_file"
    exit 1
fi

DATASET="$1"
LOCK="$2"

if [ -n "$DATASET_URL" ]; then
    # DATASET_URL always has a trailing slash; strip it to avoid '//' in S3 keys.
    BASE_URL="${DATASET_URL%/}"

    echo "Uploading dataset files to $BASE_URL ..."
    aws s3 --endpoint-url="$AWS_ENDPOINT_URL" sync --no-progress --exclude "video.mp4" "$DATASET/" "$BASE_URL/"

    mkdir -p "$DATASET/flags"
    echo yes > "$DATASET/flags/$LOCK"
    aws s3 --endpoint-url="$AWS_ENDPOINT_URL" cp --no-progress "$DATASET/flags/$LOCK" "$BASE_URL/flags/$LOCK"
else
    echo "DATASET_URL not set, not uploading temporary files."
fi
